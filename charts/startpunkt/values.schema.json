{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["single", "split"]
    },
    "crds": {
      "type": "object",
      "properties": {
        "install": { "type": "boolean" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "cluster": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "pattern": "^[^/\\s]+$" }
          }
        },
        "log": {
          "type": "object",
          "properties": {
            "level": { "enum": ["debug", "info", "warn", "error"] },
            "format": { "enum": ["json", "text"] }
          }
        }
      }
    }
  }
}
